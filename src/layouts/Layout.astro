---
import "../styles/global.css";

function randomBetween(min: number, max: number) {
  return Math.random() * (max - min) + min;
}

const bubbles = Array.from({ length: 100 }, (_, i) => ({
  size: Math.floor(Math.random() * 10) + 1,
  left: Math.floor(Math.random() * 100) + 1,
  duration: Math.round(randomBetween(20, 60)),
  translateX: Math.floor(Math.random() * 400) - 100,
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Stefano Cattaneo — Frontend Developer</title>
    <meta
      name="description"
      content="Stefano Cattaneo, Frontend Developer in Milan specializing in React and TypeScript."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌊</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="gauge" aria-hidden="true">
      <span class="gauge-label">DEPTH</span>
      <div class="gauge-track">
        <div class="gauge-fill" id="gaugeFill"></div>
      </div>
      <span class="gauge-depth" id="gaugeDepth">0 m</span>
    </div>
    <main>
      <slot />
    </main>
    {
      bubbles.map((bubble, i) => (
        <span
          class="bubble"
          style={`
        --size: ${bubble.size}px;
        --left: ${bubble.left}vw;
        --duration: ${bubble.duration}s;
        --translate-x: ${bubble.translateX}px;
      `}
        />
      ))
    }
  </body>
</html>
