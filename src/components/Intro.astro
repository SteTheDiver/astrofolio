---
import socials from "../data/social.json";
import { Icon } from "astro-icon/components";
---

<section class="hero" id="home">
  <div class="wrap">
    <h1><span>Stefano</span><span>Cattaneo</span></h1>
    <p class="hero-sub">
      I build responsive, accessible, high-performance web apps across software
      houses and large multinational teams. I work to bridge the gap between
      technical execution and stakeholders needs to drive product success.
    </p>
    <div class="hero-meta">
      <div class="icon-row">
        {
          socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              class="icon-btn"
              aria-label={social.name}
              title={social.name}
            >
              <Icon name={social.icon} class="icon" />
              <span class="social-name">{social.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
